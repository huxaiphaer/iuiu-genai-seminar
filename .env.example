# Copy this file to ".env" and fill in your key.  NEVER commit the real .env to Git.
#
# OpenRouter gives you one API that can reach many models.
# Get a free key here:  https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here

# Any model id from https://openrouter.ai/models
# Models whose id ends in ":free" cost nothing. This one is free AND supports tools.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
